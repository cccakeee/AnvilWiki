---
/**
 * AdsterraSlotPair — the standard two-position Adsterra mount shared by the
 * content pages: a fixed 728×90 banner (only mounted from md up — a 728
 * creative does not fit a phone) before the content, and the responsive
 * native banner (fills any width, covers mobile) at the end of it.
 *
 *   <AdsterraSlotPair>
 *     ...page content shown between the two units...
 *   </AdsterraSlotPair>
 *
 * Content that must render AFTER the native banner goes in the `after`
 * slot (the landing root's FinalCta keeps its pre-banner position that way):
 *
 *   <AdsterraSlotPair>
 *     <CommunitySites t={t} />
 *     <Fragment slot="after"><FinalCta t={t} /></Fragment>
 *   </AdsterraSlotPair>
 *
 * Pages that already mount the native unit elsewhere (the top-of-content
 * compact native on the landing root / handbook lessons) pass `native={false}`:
 * a unit key may appear ONCE per page (AdsterraSlot drops a second copy), so
 * the pair must not claim it twice.
 *
 * DOM order is always banner → default slot → native → after slot.
 */
import AdsterraSlot from './AdsterraSlot.astro';

interface Props {
  /** Mount the end-of-content native banner (default). Off when the page already has one. */
  native?: boolean;
}
const { native = true } = Astro.props;
---

<AdsterraSlot name="incontent-728x90" width={728} height={90} minViewport={768} />
<slot />
{native && <AdsterraSlot name="native-banner" width={700} height={240} />}
<slot name="after" />
