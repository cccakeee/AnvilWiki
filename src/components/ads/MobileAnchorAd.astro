---
/**
 * MobileAnchorAd — Adsterra 320×50 Bottom Sticky/Anchor, now available for BOTH Mobile & Desktop.
 *
 * Adaptive fit (does NOT take a full-width bar across the screen; floating card style).
 * Collapsible toggle (default expanded, uses icons for collapse/expand).
 *
 * Features:
 *   1. Collapsible toggle — icon switches between collapse (chevron-down) and expand (chevron-up).
 *      Default is expanded; the choice is remembered for the browsing session (sessionStorage).
 *   2. Zero CLS & Bottom Padding — `position: fixed` never shifts layout; while expanded a small
 *      bottom padding is added to <body> so content won't stay covered behind the floating card.
 *      Removed on collapse.
 *   3. The unit is inlined by AdsterraSlot (no iframe wrapper — see AdsterraSlot.astro). Collapsing
 *      hides the card body; the ad has already loaded by then.
 *
 * Gated on PUBLIC_ADSTERRA_SLOT_STICKY_320X50: empty = nothing rendered (zero-ad fork contract).
 */
import { Icon } from 'astro-icon/components';
import AdsterraSlot from './AdsterraSlot.astro';
import { currentSharedStrings } from '~/lib/shared-ui';

const show = !!import.meta.env.PUBLIC_ADSTERRA_SLOT_STICKY_320X50;
// Silent tracking mode: no consent banner rendered in BaseLayout, so ads load directly.
const consentBannerActive = false;
const sharedStrings = currentSharedStrings(Astro.currentLocale);
const collapseAd = sharedStrings.collapseAd ?? 'Collapse ad';
const expandAd = sharedStrings.expandAd ?? 'Expand ad';

const anchorCss = `
  #mobile-anchor-card.is-collapsed .ad-header {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  /* Keep article tail reachable above the bar when expanded */
  body.has-mobile-anchor {
    padding-bottom: 74px;
    padding-bottom: calc(74px + env(safe-area-inset-bottom, 0px));
  }
  /* Lift BackToTop button above the bar when expanded */
  body.has-mobile-anchor #back-to-top {
    bottom: 86px;
    bottom: calc(86px + env(safe-area-inset-bottom, 0px));
  }
  /* iOS home-indicator safe area */
  #mobile-anchor-ad {
    bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
  }
`;
---

{
  show && (
    <aside
      id="mobile-anchor-ad"
      class:list={[
        'pointer-events-none fixed bottom-2 left-1/2 z-30 -translate-x-1/2',
        // Hidden until consent only when a consent gate is active; otherwise the
        // unit must be laid out from first paint (its script runs at parse time).
        consentBannerActive && 'hidden',
      ]}
      data-consent-deferred={consentBannerActive ? '1' : undefined}
      aria-label={sharedStrings.adLabel ?? 'Advertisement'}
    >
      <div
        id="mobile-anchor-card"
        class="pointer-events-auto relative mx-auto flex w-fit max-w-[calc(100vw-1rem)] flex-col items-center rounded-xl border border-border/80 bg-background/95 p-1.5 shadow-lg backdrop-blur"
      >
        {/* Compact header bar: Ad marker + collapse/expand toggle */}
        <div class="ad-header flex w-full items-center justify-between gap-3 px-1 pb-1 text-[10px] text-muted-foreground border-b border-border/40 mb-1 transition-all">
          <span class="font-medium tracking-wider uppercase text-[9px] px-1 py-0.5 rounded bg-muted/60 text-muted-foreground">AD</span>
          <button
            id="toggle-mobile-anchor"
            type="button"
            aria-label={collapseAd}
            title={collapseAd}
            class="flex h-5 w-5 items-center justify-center rounded-md border border-border/60 bg-muted/50 text-muted-foreground transition hover:bg-muted hover:text-foreground"
          >
            {/* Expanded state: collapse icon (chevron-down) */}
            <span id="mobile-anchor-collapse-icon" class="flex items-center justify-center">
              <Icon name="lucide:chevron-down" class="h-3.5 w-3.5" />
            </span>
            {/* Collapsed state: expand icon (chevron-up) */}
            <span id="mobile-anchor-expand-icon" class="hidden items-center justify-center">
              <Icon name="lucide:chevron-up" class="h-3.5 w-3.5" />
            </span>
          </button>
        </div>

        {/* Ad container (collapsible) */}
        <div id="mobile-anchor-body">
          <AdsterraSlot name="sticky-320x50" width={320} height={50} bare label={false} />
        </div>
      </div>
    </aside>
  )
}

{
  show && <style set:html={anchorCss} />
}

{
  show && (
    <script is:inline define:vars={{ collapseLabel: collapseAd, expandLabel: expandAd }}>
      /* ES2018 only (no optional chaining / nullish coalescing / optional
         catch binding) — runs untranspiled in the HTML. Event + storage names
         mirror src/lib/shared-ui.ts (inline scripts can't import;
         tests/consent.test.ts pins the duplicates). */
      (function () {
        var ID = 'mobile-anchor-ad';
        var CARD_ID = 'mobile-anchor-card';
        var BODY_ID = 'mobile-anchor-body';
        var TOGGLE_ID = 'toggle-mobile-anchor';
        var COLLAPSE_ICON_ID = 'mobile-anchor-collapse-icon';
        var EXPAND_ICON_ID = 'mobile-anchor-expand-icon';
        var CONSENT_KEY = 'aw-cookie-consent';
        var CONSENT_EVENT = 'aw:consent-accepted';

        var anchor = document.getElementById(ID);
        var card = document.getElementById(CARD_ID);
        var body = document.getElementById(BODY_ID);
        var btn = document.getElementById(TOGGLE_ID);
        var collapseIcon = document.getElementById(COLLAPSE_ICON_ID);
        var expandIcon = document.getElementById(EXPAND_ICON_ID);
        if (!anchor || !card || !btn) return;

        var STATE_KEY = 'aw-anchor-ad-collapsed';
        var isExpanded = true;
        try {
          isExpanded = sessionStorage.getItem(STATE_KEY) !== '1';
        } catch (e) {
          /* storage unavailable — toggle works, just not remembered */
        }

        var updateState = function () {
          if (isExpanded) {
            if (body) body.classList.remove('hidden');
            card.classList.remove('is-collapsed');
            if (collapseIcon) collapseIcon.classList.remove('hidden');
            if (expandIcon) expandIcon.classList.add('hidden');
            btn.setAttribute('aria-label', collapseLabel);
            btn.setAttribute('title', collapseLabel);
            document.body.classList.add('has-mobile-anchor');
          } else {
            if (body) body.classList.add('hidden');
            card.classList.add('is-collapsed');
            if (collapseIcon) collapseIcon.classList.add('hidden');
            if (expandIcon) expandIcon.classList.remove('hidden');
            btn.setAttribute('aria-label', expandLabel);
            btn.setAttribute('title', expandLabel);
            document.body.classList.remove('has-mobile-anchor');
          }
        };

        var revealed = false;
        var reveal = function () {
          if (revealed) return;
          revealed = true;
          anchor.classList.remove('hidden');
          updateState();
        };

        var consentDeferred = anchor.getAttribute('data-consent-deferred') === '1';
        var wireConsent = function () {
          var stored = null;
          try {
            stored = localStorage.getItem(CONSENT_KEY);
          } catch (e) {
            /* treat as no consent yet */
          }
          if (stored === 'accepted') {
            reveal();
            return;
          }
          document.addEventListener(CONSENT_EVENT, reveal);
        };

        if (consentDeferred) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', wireConsent);
          } else {
            wireConsent();
          }
        } else {
          reveal();
        }

        btn.addEventListener('click', function () {
          isExpanded = !isExpanded;
          updateState();
          try {
            sessionStorage.setItem(STATE_KEY, isExpanded ? '0' : '1');
          } catch (e) {
            /* storage unavailable */
          }
        });
      })();
    </script>
  )
}
