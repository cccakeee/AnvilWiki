---
/**
 * TopStickyAd — Adsterra 728×90, floating at the top of the viewport.
 *
 * FLOATS: `position: fixed`, pinned under the 56px sticky header, so it takes
 * no space in the document flow and never pushes page content down (the first
 * version was `sticky` = in-flow, which shoved <main> down by the card height).
 * Same floating-card look as the bottom MobileAnchorAd; the full-width wrapper
 * is click-through, only the card itself takes pointer events, so the margins
 * on both sides stay usable.
 *
 * Desktop/tablet only (md+): a 728 creative does not fit a phone, and a
 * floating native-banner is not an option there (its responsive script turns
 * into a ~525px tall vertical stack below ~700px wide — it would cover most of
 * a phone screen). Phones are covered by the bottom 320×50 anchor and the
 * in-article units. `minViewport` keeps the unit's code from being written on
 * phones at all (no request, no phantom impression); the wrapper is also
 * `hidden md:flex` so no empty card chrome shows there.
 *
 * Collapse/expand (icon button, default expanded). The choice is remembered for
 * the browsing session only (sessionStorage) — a new visit starts expanded.
 * Collapsing hides the card body; the ad has already loaded by then.
 *
 * Mounted at the END of LocaleLayout (after the footer): it is fixed, so DOM
 * order is invisible, and Adsterra's script is parser-blocking — placed before
 * <main> it would hold the whole article's first paint hostage to a third-party
 * request.
 *
 * Gated on PUBLIC_ADSTERRA_SLOT_INCONTENT_728X90: empty = nothing rendered
 * (zero-ad fork contract). Unit name keeps the legacy `incontent-` prefix so
 * existing env vars / public/ads/incontent-728x90.html stay valid.
 */
import { Icon } from 'astro-icon/components';
import AdsterraSlot from './AdsterraSlot.astro';
import { currentSharedStrings } from '~/lib/shared-ui';

const show = !!import.meta.env.PUBLIC_ADSTERRA_SLOT_INCONTENT_728X90;
const sharedStrings = currentSharedStrings(Astro.currentLocale);
const collapseAd = sharedStrings.collapseAd ?? 'Collapse ad';
const expandAd = sharedStrings.expandAd ?? 'Expand ad';
const adLabel = sharedStrings.adLabel ?? 'Advertisement';

// Astro hoists static <style> tags out of JSX conditionals — a hoisted style
// would ship dead rules into every zero-ad fork page. `show` is a build-time
// constant, so the CSS renders as a raw gated element instead.
const topStickyCss = `
  #top-sticky-card.is-collapsed .ad-header {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }
`;
---

{
  show && (
    <aside
      id="top-sticky-ad"
      class="pointer-events-none fixed inset-x-0 top-[3.75rem] z-30 hidden justify-center px-2 md:flex"
      aria-label={adLabel}
    >
      <div
        id="top-sticky-card"
        class="pointer-events-auto flex w-fit max-w-full flex-col items-center rounded-xl border border-border/80 bg-background/95 p-1.5 shadow-md backdrop-blur"
      >
        {/* Compact header row: ad marker + collapse/expand icon button */}
        <div class="ad-header mb-1 flex w-full items-center justify-between gap-3 border-b border-border/40 px-1 pb-1 text-muted-foreground">
          <span class="rounded bg-muted/60 px-1 py-0.5 text-[9px] font-medium uppercase tracking-wider">AD</span>
          <button
            id="toggle-top-sticky"
            type="button"
            aria-controls="top-sticky-body"
            aria-expanded="true"
            aria-label={collapseAd}
            title={collapseAd}
            data-collapse-label={collapseAd}
            data-expand-label={expandAd}
            class="flex h-5 w-5 items-center justify-center rounded-md border border-border/60 bg-muted/50 text-muted-foreground transition hover:bg-muted hover:text-foreground"
          >
            {/* Expanded → show the "collapse" icon (chevron-up: the card tucks up) */}
            <span id="top-sticky-collapse-icon" class="flex items-center justify-center">
              <Icon name="lucide:chevron-up" class="h-3.5 w-3.5" />
            </span>
            {/* Collapsed → show the "expand" icon (chevron-down) */}
            <span id="top-sticky-expand-icon" class="hidden items-center justify-center">
              <Icon name="lucide:chevron-down" class="h-3.5 w-3.5" />
            </span>
          </button>
        </div>

        <div id="top-sticky-body">
          <AdsterraSlot name="incontent-728x90" width={728} height={90} minViewport={768} bare label={false} />
        </div>
      </div>
    </aside>
  )
}

{show && <style set:html={topStickyCss} />}

{
  show && (
    <script is:inline>
      /* ES2018 only (no optional chaining / nullish coalescing / optional
         catch binding) — runs untranspiled in the HTML. */
      (function () {
        var KEY = 'aw-top-ad-collapsed';
        var card = document.getElementById('top-sticky-card');
        var body = document.getElementById('top-sticky-body');
        var btn = document.getElementById('toggle-top-sticky');
        var collapseIcon = document.getElementById('top-sticky-collapse-icon');
        var expandIcon = document.getElementById('top-sticky-expand-icon');
        if (!card || !body || !btn) return;

        var expanded = true;
        try {
          expanded = sessionStorage.getItem(KEY) !== '1';
        } catch (e) {
          /* storage unavailable — toggle works, just not remembered */
        }

        var apply = function () {
          var label = btn.getAttribute(expanded ? 'data-collapse-label' : 'data-expand-label');
          body.classList.toggle('hidden', !expanded);
          card.classList.toggle('is-collapsed', !expanded);
          if (collapseIcon) collapseIcon.classList.toggle('hidden', !expanded);
          if (expandIcon) expandIcon.classList.toggle('hidden', expanded);
          btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          if (label) {
            btn.setAttribute('aria-label', label);
            btn.setAttribute('title', label);
          }
        };
        apply();

        btn.addEventListener('click', function () {
          expanded = !expanded;
          apply();
          try {
            sessionStorage.setItem(KEY, expanded ? '0' : '1');
          } catch (e) {
            /* storage unavailable */
          }
        });
      })();
    </script>
  )
}
