---
/**
 * AdsterraSlot — mounts one Adsterra ad unit by inlining the dashboard code
 * VERBATIM into the page. There is no iframe wrapper any more.
 *
 * Why (read before "improving" this back): Adsterra's compliance notice says
 * placing an ad code inside an iframe is not permitted — the old mount put
 * every unit into our own sandboxed `<iframe src="/ads/<name>.html">`, which
 * is that exact pattern (wrapper that can shrink/overlay the ad, delay its
 * load, and sit between the ad and its click/impression tracking). The ad
 * network's script still builds ITS OWN ad frame; that frame is the ad.
 * Mechanics + the "atOptions clobber" analysis: src/lib/adsterra.ts.
 *
 * Source of the code: `public/ads/<name>.html` — unchanged fork workflow, paste
 * the snippet from Adsterra (Ad Units → GET CODE) into that file. Only its
 * <body> content is inlined, at build time. The file is not an iframe target
 * any more; it is just the per-unit source of truth.
 *
 * Gated on PUBLIC_ADSTERRA_SLOT_<NAME> (name upper-cased, hyphens → underscores:
 * `sidebar-300x250` → `PUBLIC_ADSTERRA_SLOT_SIDEBAR_300X250`). Empty = nothing
 * rendered (zero-ad fork contract). Env set but html file missing/empty = build
 * warning + nothing rendered.
 *
 * Rules enforced here:
 *   - ONE mount per unit per page (a second copy is dropped with a warning —
 *     Adsterra's "one code, one position", and it would duplicate the native
 *     format's container id).
 *   - Never CSS-hide a mounted unit: a hidden unit still requests an ad and
 *     books an impression nobody can see. Viewport-dependent units use
 *     `minViewport`, which decides at parse time whether the code is written
 *     into the page at all.
 *   - No consent deferral: this fork runs silent analytics/ads (no banner), the
 *     old data-src promotion existed only for the iframe mount.
 */
interface Props {
  /** Slot name = html filename stem under public/ads/ (e.g. `sidebar-300x250`). */
  name: string;
  /** Creative width in px — keep in sync with the unit's Adsterra size. */
  width: number;
  /** Creative height in px — reserved before the ad paints (zero CLS). */
  height: number;
  /** Set to `false` to hide the "Advertisement" label (labels default on). */
  label?: boolean;
  /**
   * Mount only on viewports at least this wide (px). Use for fixed-size
   * creatives wider than a phone (728 / 468): below the threshold the code is
   * never written, so no request and no phantom impression.
   */
  minViewport?: number;
  /**
   * No outer margin and no label: for floating cards that provide their own
   * chrome (TopStickyAd / MobileAnchorAd).
   */
  bare?: boolean;
  /** Extra classes for the outer wrapper (e.g. spacing in a sidebar column). */
  class?: string;
}

import { claimSlot, gateByViewport, loadSlotSnippet, slotEnvKey } from '~/lib/adsterra';
import { currentSharedStrings } from '~/lib/shared-ui';

const { name, width, height, label = true, minViewport, bare = false, class: extraClass } = Astro.props;
const envKey = slotEnvKey(name);

let html: string | null = null;
if (import.meta.env[envKey]) {
  const snippet = loadSlotSnippet(name);
  if (!snippet) {
    console.warn(`[AdsterraSlot] ${envKey} is set but public/ads/${name}.html is missing or empty — slot skipped.`);
  } else if (!claimSlot(Astro.request, name)) {
    console.warn(`[AdsterraSlot] "${name}" is mounted twice on ${Astro.url.pathname} — the second copy was dropped (one code per position).`);
  } else {
    html = minViewport ? gateByViewport(snippet, minViewport) : snippet;
  }
}

const sharedStrings = currentSharedStrings(Astro.currentLocale);
const adLabel = sharedStrings.adLabel ?? 'Advertisement';
// Below the viewport gate the (empty) reserved box must not leave a gap.
const gateCss = minViewport ? `@media (max-width:${Math.max(1, Math.floor(minViewport)) - 1}px){[data-adsterra-slot="${name}"]{display:none}}` : '';
---
{
  html && (
    <>
      <div
        class:list={['flex flex-col items-center justify-center', bare ? '' : 'my-8', extraClass]}
        data-adsterra-slot={name}
      >
        {label && !bare && (
          <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{adLabel}</span>
        )}
        <div
          class="mx-auto w-full text-center [&>iframe]:mx-auto [&>iframe]:block"
          style={`max-width:${width}px;min-height:${height}px`}
        >
          <Fragment set:html={html} />
        </div>
      </div>
      {gateCss && <style set:html={gateCss} />}
    </>
  )
}
