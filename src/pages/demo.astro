---
/**
 * /demo — the demo site's English wiki homepage.
 *
 * In the demo build the root `/` is the project storefront gateway (301 to
 * /zh/landing/ via public/_redirects + the RootGateway shadow page), so the
 * English wiki homepage lives HERE. Forks do not build this page — it is the
 * one demo-exclusive page file, registered in LANDING_PATHS (apply-template)
 * + the setup.yml rm line + the e2e absence assertions.
 *
 * homeUrl('en') returns '/demo/' in demo builds, so the canonical
 * (BaseLayout derives it from Astro.url.pathname — self-referencing /demo/)
 * and the hreflang cluster (en → /demo/, ja → /ja/, x-default → /demo/) stay
 * self-consistent automatically. Zero demo-game strings — template-audit's
 * code-purity check never matches this file.
 */
import HomePage from '~/components/home/HomePage.astro';
import { defaultLocale, locales } from '~/i18n/routing';
import { videoGameJsonLd, websiteJsonLd } from '~/lib/seo';
import { homeUrl, languageAlternates } from '~/lib/url';

const locale = defaultLocale;
const jsonLd = [websiteJsonLd(locale), videoGameJsonLd()];
// hreflang alternates via homeUrl: en → '/demo/' in demo builds ('/' in
// forks, byte-identical to the pre-gateway output), others → /<locale>/.
const alternates = languageAlternates((loc) => homeUrl(loc), locales);
---

<HomePage locale={locale} jsonLd={jsonLd} alternates={alternates} />
